# ============================================================
# My-Workspace .gitignore
# 适用于 Windows 工作区，兼顾 Python / Node / 常见 IDE
# 目标：只提交真实内容（如「每日新闻」归档），排除系统/编辑器/语言
#       临时文件与本地私密数据。
# ============================================================

# ---------- 1. 操作系统生成文件 ----------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble/
.Spotlight-V100/
.Trashes
# Linux
.directory

# ---------- 2. 编辑器 / IDE 临时文件 ----------
# 通用
*.swp
*.swo
*~
*.tmp
*.temp
*.bak
# Vim
.netrwhist
# Visual Studio Code
.vscode/
# JetBrains (PyCharm / IDEA 等)
.idea/
*.iml
# Sublime Text
*.sublime-*

# ---------- 3. 日志 ----------
*.log
logs/

# ---------- 4. Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/

# ---------- 5. Node / 前端 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cache/
dist/
build/
out/

# ---------- 6. 本地私密数据 / 运行态 ----------
# WorkBuddy 本地记忆、自动化运行时状态等，属个人私有数据，不进版本库
.workbuddy/

# ---------- 7. 自动化运行时随机条数（临时产物，不进版本库） ----------
每日新闻/.runtime/
