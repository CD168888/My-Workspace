# ============================================================
# My-Workspace .gitignore
# 适用于 Windows 工作区，兼顾 Python / Node / 常见 IDE
# 目标：只提交真实内容（如「每日新闻」归档），排除系统/编辑器/语言
#       临时文件与本地私密数据。
# ============================================================

# ---------- 1. 操作系统生成文件 ----------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble/
.Spotlight-V100/
.Trashes
# Linux
.directory

# ---------- 2. 编辑器 / IDE 临时文件 ----------
# 通用
*.swp
*.swo
*~
*.tmp
*.temp
*.bak
# Vim
.netrwhist
# Visual Studio Code
.vscode/
# JetBrains (PyCharm / IDEA 等)
.idea/
*.iml
# Sublime Text
*.sublime-*

# ---------- 3. 日志 ----------
*.log
logs/

# ---------- 4. Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/

# ---------- 5. Node / 前端 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cache/
dist/
build/
out/

# ---------- 6. 本地私密数据 / 运行态 ----------
# WorkBuddy 本地记忆、自动化运行时状态等，属个人私有数据，不进版本库
.workbuddy/

# Codex 本地技能与运行态文件，不进版本库
.codex/

# ---------- 7. 自动化运行时状态（临时产物，不进版本库） ----------
每日新闻/.runtime/
公众号/.runtime/

# ---------- 8. 凭据与私密配置（绝不进版本库） ----------
# 公众号 AppSecret、渲染服务账号等；一旦提交等同于泄露，需到后台重置
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
公众号/配置/
*.secret
*.token

# ---------- 9. 公众号素材中间产物（派生文件，不进版本库） ----------
# 封面：底图中转态、试验稿、旧版备份，都是可随时重跑脚本再生成的，入了库只会堆垃圾
公众号/素材/**/ai_cover_v2/_*.png
公众号/素材/**/ai_cover_v2/bg_clean.png
公众号/素材/**/ai_cover_v2/bg_shift.png
公众号/素材/**/ai_cover_v2/cover_news_a.png
公众号/素材/**/ai_cover_v2/cover_news_b.png
# 被霓虹拼贴取代的纪实风候选底图，以及最终图的重复副本
公众号/素材/**/ai_cover_v2/Documentary_*.png
公众号/素材/**/ai_cover_v2/Extreme_*.png
公众号/素材/**/ai_cover_v2/cover_neon_final.png
公众号/素材/**/ai_cover_v2/cover_news.png
公众号/素材/**/cover_news_v*.png
# 抓图脚本落下的原始目录（photo_*），用得到时重抓即可
公众号/素材/**/photo_*/
# 被 cover_neon.py 取代的旧封面脚本，留档在本地不入库
公众号/脚本/cover_2026_10_26_v2.py
